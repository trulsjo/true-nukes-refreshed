#!/bin/sh
# Checks the message against the convention declared in
# vendor/grado-factorio-tools/docs/commit-convention.md. The rules and the reasons live there and
# in the check it runs; this is only the wiring, so git has something without an extension to run.
# Same wiring as realistic-fusion-refreshed's .githooks/commit-msg.
#
# INSTALL, twice per clone, because git tracks neither .git/hooks nor a submodule's contents:
#
#     git submodule update --init
#     git config core.hooksPath .githooks
#
# The message file survives a rejection, so `git commit -e -F .git/COMMIT_EDITMSG` reopens what you
# typed rather than making you write it again.
#
# If pwsh is missing, say so and let the commit through rather than blocking work.
if ! command -v pwsh >/dev/null 2>&1; then
    echo "commit-msg: pwsh not found, so the message format was NOT checked." >&2
    exit 0
fi

# A clone that skipped `git submodule update --init` has an empty vendor directory, so the check
# cannot be resolved. Say so and let the commit through -- the posture the tooling repo's ADR 0001
# requires. Left to pwsh this would be exit 64 and a usage dump, which blocks the commit and names
# nothing the author can act on.
CHECK="$(git rev-parse --show-toplevel)/vendor/grado-factorio-tools/scripts/commit-check.ps1"
if [ ! -f "$CHECK" ]; then
    echo "commit-msg: $CHECK not found, so the message format was NOT checked." >&2
    echo "commit-msg: run 'git submodule update --init' to wire up the shared check." >&2
    exit 0
fi

exec pwsh -NoProfile -File "$CHECK" "$1"
